# docs/project-overview.md 3.5 LLM 라우팅 참고.
# 판단/요약(가맹점 판단 confirm·escalate, 자연어 QA, 주간 브리핑)은 GROQ_API_KEY를 쓴다.
# 실 웹 검색(Google Search grounding)만 GEMINI_API_KEY를 쓴다 — Groq엔 이 기능이 없음.
GEMINI_API_KEY=
GROQ_API_KEY=
# GEMINI_MODEL=gemini/gemini-flash-latest
# GROQ_MODEL=groq/openai/gpt-oss-20b

# docs/project-overview.md 4장 보안 설계 참고. POST /webhook/capture의 Authorization
# 헤더와 완전히 일치해야 한다. 랜덤 문자열로 채워넣을 것 (예: openssl rand -hex 32).
CAPTURE_WEBHOOK_TOKEN=

# docs/project-overview.md 3.3 저장소 참고. docker-compose의 db(Postgres) 서비스 접속 정보.
# POSTGRES_PASSWORD는 랜덤 문자열로 채워넣을 것 (예: openssl rand -hex 16).
POSTGRES_USER=spending
POSTGRES_PASSWORD=
POSTGRES_DB=spending
# app 컨테이너가 db 서비스(컨테이너명 db, 포트 5432)에 접속하는 연결 문자열.
# 위 세 값과 반드시 일치시킬 것.
DATABASE_URL=postgresql://spending:changeme@db:5432/spending

# docs/project-overview.md 3.6 알림 참고. escalate 건 사람 개입 알림 (ntfy.sh, 무료).
# NTFY_TOPIC은 아무나 추측 못 하게 랜덤 문자열로 (예: openssl rand -hex 16). 아이폰
# ntfy 앱에서 이 토픽을 구독하면 됨.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
# 아이폰이 캡처 웹훅을 보내는 것과 같은 LAN IP:포트. 알림의 "확인하기" 버튼이 여는 주소.
PUBLIC_BASE_URL=http://192.168.0.66:8000
