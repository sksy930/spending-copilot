# docs/project-overview.md 3.5 LLM 라우팅 참고.
# 판단/요약(가맹점 판단 confirm·escalate, 자연어 QA, 주간 브리핑)은 GROQ_API_KEY를 쓴다.
# 실 웹 검색(Google Search grounding)만 GEMINI_API_KEY를 쓴다 — Groq엔 이 기능이 없음.
GEMINI_API_KEY=
GROQ_API_KEY=
# GEMINI_MODEL=gemini/gemini-flash-latest
# GROQ_MODEL=groq/llama-3.3-70b-versatile

# docs/project-overview.md 4장 보안 설계 참고. POST /webhook/capture의 Authorization
# 헤더와 완전히 일치해야 한다. 랜덤 문자열로 채워넣을 것 (예: openssl rand -hex 32).
CAPTURE_WEBHOOK_TOKEN=
